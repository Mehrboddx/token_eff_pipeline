# GPU image for the benchmarks (eval/longmemeval.py) and the analyses that
# read cached scores (analysis/). Needed for the CPC presets, especially
# --cpc-preset mistral (a full 7B model).
#
# Build from the project root, since the code imports core/ and
# replicate/cpc_compressor.py:
#   docker build -f Dockerfile.eval -t longmemeval-eval .

FROM python:3.11-slim

WORKDIR /app

# python:3.11-slim has no C compiler. Triton (which PyTorch's "sdpa"
# attention backend can JIT-compile kernels through, depending on the
# GPU/driver combo it lands on) needs one at runtime -- without it every
# forward pass fails with "Failed to find C compiler", which fails
# identically on every single question since it's the very first kernel
# the model tries to run.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# cu128 wheels: they run on Vertex AI's L4/T4 and on Blackwell cards
# (cu126 has no RTX 50xx kernels). The NVIDIA driver itself comes from the
# GPU VM at runtime, not from this image.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu128

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
# spaCy's small English pipeline for --source ner entity keys (eval/entity_keys.py).
RUN python -m spacy download en_core_web_sm

# Only what the benchmarks and analyses import -- not the rest of
# replicate/ (run_long_bench.py, gemini_compressor.py, etc. are unrelated
# to this eval and would just pull in unused dependencies).
COPY core/ ./core/
COPY eval/ ./eval/
COPY analysis/ ./analysis/
COPY integrations/ ./integrations/
COPY replicate/cpc_compressor.py ./replicate/cpc_compressor.py

ENTRYPOINT ["python", "-m", "eval.longmemeval"]
